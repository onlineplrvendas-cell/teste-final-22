rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSystemAdmin() {
      return hasUserDoc() && getUserDoc().role == 'admin' && getUserDoc().active == true;
    }

    function isStaffMember() {
      return hasUserDoc() && getUserDoc().active == true;
    }

    function isConexaoGeneralLeader() {
      return isSystemAdmin() || (
        hasUserDoc() && getUserDoc().active == true && getUserDoc().role == 'lider_conexao'
      );
    }

    function inMyCongregations(congregationName) {
      return isSystemAdmin() || (isStaffMember() && congregationName in getUserDoc().assignedCongregations);
    }

    function canAccessContact(data) {
      return inMyCongregations(data.congregation) &&
        (getUserDoc().role != 'lider_familia' ||
          (data.congregation == 'Curicica' && data.curicicaFamily == getUserDoc().assignedCuricicaFamily));
    }

    function canAccessWeeklyReport(data) {
      return inMyCongregations(data.congregation) &&
        (getUserDoc().role != 'lider_familia' || data.curicicaFamily == getUserDoc().assignedCuricicaFamily);
    }

    function canAccessFamilyScopedData(data) {
      return getUserDoc().role != 'lider_familia' ||
        (data.congregation == 'Curicica' && data.curicicaFamily == getUserDoc().assignedCuricicaFamily);
    }

    function canAccessConexaoParticipant(data) {
      return isSignedIn() && isStaffMember() && (
        isSystemAdmin() || isConexaoGeneralLeader() ||
        getUserDoc().role != 'lider_equipe' || data.color == getUserDoc().assignedTeam
      );
    }

    // Users Collection
    match /users/{userId} {
      // User can read their own document; staff can read user documents for assignment lookups
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaffMember());
      allow list: if isSignedIn() && isStaffMember();

      // Provision profiles through an authenticated administrator only.
      // The first administrator must be created using the Firebase Console.
      allow create: if isSystemAdmin() && request.resource.data.uid == userId &&
        !request.resource.data.keys().hasAny(['password']);
      allow update: if isSystemAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'email',
          'username',
          'password',
          'role',
          'assignedCongregations',
          'assignedTeam',
          'assignedCuricicaFamily',
          'active'
        ])
      );
      allow delete: if isSystemAdmin();
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow get, list: if canAccessContact(resource.data);

      allow create: if canAccessContact(request.resource.data) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0;

      allow update: if canAccessContact(resource.data) && canAccessContact(request.resource.data);

      allow delete: if isSystemAdmin();
    }

    // Conexão Jovem Participants Collection
    match /conexao_participants/{participantId} {
      allow get, list: if canAccessConexaoParticipant(resource.data);

      allow create: if isSignedIn() && isStaffMember() && (
        isSystemAdmin() ||
        isConexaoGeneralLeader() ||
        getUserDoc().role != 'lider_equipe' ||
        request.resource.data.color == getUserDoc().assignedTeam
      );

      allow update: if isSignedIn() && isStaffMember() && (
        isSystemAdmin() ||
        isConexaoGeneralLeader() ||
        getUserDoc().role != 'lider_equipe' ||
        resource.data.color == getUserDoc().assignedTeam
      );

      allow delete: if isSignedIn() && (isSystemAdmin() || isConexaoGeneralLeader());
    }

    // Conexão Team Goals Collection
    match /conexao_goals/{goalId} {
      allow get, list: if isSignedIn() && isStaffMember();
      allow create, update, delete: if isSystemAdmin() || isConexaoGeneralLeader();
    }

    // Interactions Collection
    match /interactions/{interactionId} {
      allow get, list: if inMyCongregations(resource.data.congregation) && canAccessFamilyScopedData(resource.data);
      allow create: if inMyCongregations(request.resource.data.congregation) && canAccessFamilyScopedData(request.resource.data);
      allow update: if inMyCongregations(resource.data.congregation) && inMyCongregations(request.resource.data.congregation) &&
        canAccessFamilyScopedData(resource.data) && canAccessFamilyScopedData(request.resource.data);
      allow delete: if isSystemAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get, list: if inMyCongregations(resource.data.congregation) && canAccessFamilyScopedData(resource.data);
      allow create: if inMyCongregations(request.resource.data.congregation) && canAccessFamilyScopedData(request.resource.data);
      allow update: if inMyCongregations(resource.data.congregation) && inMyCongregations(request.resource.data.congregation) &&
        canAccessFamilyScopedData(resource.data) && canAccessFamilyScopedData(request.resource.data);
      allow delete: if isSystemAdmin();
    }

    // Weekly Confirmations Collection
    match /weekly_confirmations/{reportId} {
      allow get, list: if canAccessWeeklyReport(resource.data);
      allow create: if canAccessWeeklyReport(request.resource.data);
      allow update: if canAccessWeeklyReport(resource.data) && canAccessWeeklyReport(request.resource.data);
      allow delete: if isSystemAdmin();
    }

    // Conexão monthly results
    match /conexao_monthly_results/{resultId} {
      allow get, list: if isSignedIn() && isStaffMember();
      allow create, update: if isSystemAdmin() || isConexaoGeneralLeader();
      allow delete: if isSystemAdmin() || isConexaoGeneralLeader();
    }
  }
}
